@import "~/.cache/wal/colors-rofi-dark.rasi"

* {
    background-color: transparent;
    text-color:       @foreground;
    accent:           @selected-normal-background;
}

window {
    background-color: @background;
    padding:          25;
    width:            850px;
    border-radius:    25px;
}

mainbox {
    children: [ "inputbar", "listview", "sidebar" ];
}

listview {
    scrollbar:     false;
    columns:       5;
    lines:         3;
    fixed-columns: true;
    spacing:       20px;
    padding:       10px 0px;
}

element {
    padding:       15px;
    border-radius: 20px;
    orientation:   vertical;
    cursor: pointer; 
}

element-icon {
    size:             4.5em;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    padding:          10px 0px 0px 0px;
    text-color:       inherit;
}

sidebar {
    border:       2px 0px 0px;
    border-color: @accent;
    padding:      10px 0px 0px;
}

button {
    text-color: @foreground;
    font: "Symbols Nerd Font 12";   /* ensures glyphs render */
    padding: 8px;
    opacity: 0.6;                   /* faded look, like a placeholder */
}

button selected {
    background-color: @accent;
    text-color:       @background;
    border-radius:    10px;
    opacity: 1.0;                   /* full opacity when active */
}

inputbar {
    padding:    5px 5px 15px 5px;
    children:   [ "prompt", "entry" ];
}

prompt {
    text-color: @accent;
    padding:    0px 10px 0px 0px;
    font:       "Bold 12";
}

entry {
    placeholder: "Search here";   /* hint text before typing */
    text-color:  @foreground;
}

