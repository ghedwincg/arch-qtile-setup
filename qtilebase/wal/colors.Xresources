! X colors.
! Generated by 'wal'
*foreground:        #dee9f1
*background:        #1e2b12
*.foreground:       #dee9f1
*.background:       #1e2b12
emacs*foreground:   #dee9f1
emacs*background:   #1e2b12
URxvt*foreground:   #dee9f1
XTerm*foreground:   #dee9f1
UXTerm*foreground:  #dee9f1
URxvt*background:   [100]#1e2b12
XTerm*background:   #1e2b12
UXTerm*background:  #1e2b12
URxvt*cursorColor:  #dee9f1
XTerm*cursorColor:  #dee9f1
UXTerm*cursorColor: #dee9f1
URxvt*borderColor:  [100]#1e2b12

! Colors 0-15.
*.color0: #1e2b12
*color0:  #1e2b12
*.color1: #5CADFA
*color1:  #5CADFA
*.color2: #44C6CC
*color2:  #44C6CC
*.color3: #68E0E8
*color3:  #68E0E8
*.color4: #A5C3A9
*color4:  #A5C3A9
*.color5: #92B9FB
*color5:  #92B9FB
*.color6: #9FE2EB
*color6:  #9FE2EB
*.color7: #dee9f1
*color7:  #dee9f1
*.color8: #9ba3a8
*color8:  #9ba3a8
*.color9: #5CADFA
*color9:  #5CADFA
*.color10: #44C6CC
*color10:  #44C6CC
*.color11: #68E0E8
*color11:  #68E0E8
*.color12: #A5C3A9
*color12:  #A5C3A9
*.color13: #92B9FB
*color13:  #92B9FB
*.color14: #9FE2EB
*color14:  #9FE2EB
*.color15: #dee9f1
*color15:  #dee9f1

! Black color that will not be affected by bold highlighting.
*.color66: #1e2b12
*color66:  #1e2b12

! Xclock colors.
XClock*foreground: #dee9f1
XClock*background: #1e2b12
XClock*majorColor:  rgba:de/e9/f1/ff
XClock*minorColor:  rgba:de/e9/f1/ff
XClock*hourColor:   rgba:de/e9/f1/ff
XClock*minuteColor: rgba:de/e9/f1/ff
XClock*secondColor: rgba:de/e9/f1/ff

! Set depth to make transparency work.
URxvt*depth: 32
